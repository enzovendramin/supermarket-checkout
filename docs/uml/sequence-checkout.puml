@startuml sequence-checkout
title Checkout and bill computation

actor Cashier
participant "CLI" as CLI
participant CashRegister
participant Cart
participant "DiscountPlan" as Plan
participant "DeliveryCalculator" as Calc

Cashier -> CLI : startCheckout alice
CLI -> CashRegister : startCheckout(customer, delivery)

Cashier -> CLI : scanItem steak 1
CLI -> CashRegister : scanItem(item, 1)
CashRegister -> Cart : addEntry(entry)

Cashier -> CLI : computeBill
CLI -> CashRegister : computeBill()
CashRegister -> Cart : entries(), totalWeightKg()
CashRegister -> Plan : applyDiscount(subtotal)
CashRegister -> Calc : computeFee(weight, distance, total)
CashRegister -> Plan : applyDeliveryDiscount(fee)
CashRegister --> CLI : Receipt
@enduml
