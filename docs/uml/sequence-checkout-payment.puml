@startuml sequence-checkout-payment
title Checkout & Payment — Sequence Diagram

actor Cashier
participant CommandDispatcher as CLI
participant Supermarket
participant CashRegister
participant Cart
participant "DiscountPlan" as Plan
participant "DeliveryCalculator" as Calc
participant POSDevice
participant "TAS" as TAS
participant Inventory

== Open checkout ==
Cashier -> CLI : startCheckout alice
CLI -> Supermarket : openCheckout("alice")
Supermarket -> CashRegister : startCheckout(customer, deliveryRequest)

== Scan items ==
Cashier -> CLI : scanItem steak 1
CLI -> CashRegister : scanItem(item, 1)
CashRegister -> Cart : addEntry(CartEntry)

== Compute bill ==
Cashier -> CLI : computeBill
CLI -> CashRegister : computeBill()
CashRegister -> Cart : entries / totalWeightKg()
CashRegister -> Plan : applyDiscount(subtotal)
CashRegister -> Calc : computeFee(weight, distance, total)
CashRegister -> Plan : applyDeliveryDiscount(fee)
CashRegister --> CLI : Receipt

== Pay ==
Cashier -> CLI : pay 4242... 1234
CLI -> CashRegister : pay(card, pin)
CashRegister -> CashRegister : check stock per entry
CashRegister -> POSDevice : pay(card, pin, total)
alt forced outcome set (simulatePayment)
    POSDevice --> CashRegister : forced PaymentResult
else real flow
    POSDevice -> TAS : authorise(card, total)
    TAS --> POSDevice : PaymentResult
end
alt SUCCESS
    CashRegister -> Inventory : decrement(item, qty)
    note right of Inventory : may fire low-stock alert (R9)
    CashRegister -> CashRegister : totalRevenue += total
    CashRegister --> CLI : SUCCESS + Receipt
else failure
    CashRegister --> CLI : INSUFFICIENT_FUNDS / PIN_WRONG / AUTH_DENIED
end

@enduml
